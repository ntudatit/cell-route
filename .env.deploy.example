# Copy to .env.deploy and replace every CHANGE_ME value.
POSTGRES_DB=fiberpay
POSTGRES_USER=fiberpay
POSTGRES_PASSWORD=CHANGE_ME_LONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_ORIGIN=http://localhost:8088
PORTAL_PORT=8088

CKB_NETWORK=testnet
# Optional overrides. Leave both empty to use the selected network default.
CKB_RPC_URL=
CKB_INDEXER_URL=
FIBER_RUNTIME=wasm
# Server-side settlement is opt-in for one merchant receiver.
FIBER_RPC_URL=
FIBER_BISCUIT_TOKEN=
API_TRUSTED_PROXY_IP=
FIBER_MERCHANT_WALLET=
FIBER_MERCHANT_NODE_PUBKEY=
OPERATOR_WALLETS=
FIBER_EXPECTED_VERSION=0.9.0
FIBER_CONFIG_PATH=/fiber-config/testnet.yml

LOG_JSON=true
RUST_LOG=rust_service=info,tower_http=info
OTEL_SERVICE_NAME=fiberpay-api
OTEL_EXPORTER_OTLP_ENDPOINT=

AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
MCP_API_KEY=
