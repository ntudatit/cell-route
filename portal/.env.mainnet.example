VITE_API_URL=https://your-production-api.example.com/api
VITE_CKB_NETWORK=mainnet
# Optional dedicated HTTPS JSON-RPC with indexer support. No credentials in this URL.
# VITE_CKB_MAINNET_RPC_URL=https://your-mainnet-node.example.com
VITE_FIBER_NETWORK=mainnet
# Mainnet Fiber requires an operator-provided mainnet.yml; only testnet.yml is bundled.
VITE_FIBER_MAINNET_ENABLED=false
VITE_FIBER_CONFIG_PATH=/fiber-config/mainnet.yml
VITE_FIBER_DATABASE_PREFIX=fiberops:mainnet:browser-node-v1
