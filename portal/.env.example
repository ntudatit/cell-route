VITE_API_URL=http://localhost:8080/api
VITE_CKB_NETWORK=testnet
VITE_FIBER_NETWORK=testnet
VITE_FIBER_CONFIG_PATH=/fiber-config/testnet.yml
VITE_FIBER_EXPECTED_VERSION=0.9.0
VITE_FIBER_DATABASE_PREFIX=fiberops:testnet:browser-node-v1

# Optional public SSRI service configuration (never put API secrets in VITE_ variables).
VITE_SSRI_NODE_URL=https://testnet.ckb.dev
VITE_SSRI_SERVER_URL=
# Use relays on the same configured Fiber network.
VITE_FIBER_RELAY_A=
VITE_FIBER_RELAY_B=
# Optional dedicated public/read-only providers; use server-side proxies for API secrets.
VITE_RGBPP_TESTNET_CKB_RPC=https://testnet.ckb.dev
VITE_RGBPP_TESTNET_BTC_API=https://mempool.space/testnet/api
VITE_RGBPP_MAINNET_CKB_RPC=https://mainnet.ckb.dev
VITE_RGBPP_MAINNET_BTC_API=https://mempool.space/api
