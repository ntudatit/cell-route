{
  "name": "portal",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "dev:mainnet": "vite --mode mainnet",
    "build:mainnet": "tsc -b && vite build --mode mainnet",
    "check:mainnet": "node scripts/check-mainnet.mjs",
    "test:e2e:mainnet": "npm run build:mainnet && playwright test --config=playwright.mainnet.config.ts"
  },
  "dependencies": {
    "@ckb-ccc/connector-react": "^1.1.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@ckb-ccc/spore": "^1.6.9",
    "react-router-dom": "^7.8.2",
    "@nervosnetwork/fiber-js": "0.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@playwright/test": "^1.62.1"
  }
}
