# Copy to a local ignored env file and fill in deployment-specific settings.
CKB_NETWORK=mainnet
CKB_RPC_URL=https://mainnet.ckb.dev
CKB_INDEXER_URL=https://mainnet.ckb.dev
CORS_ORIGIN=https://your-portal.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cellroute_mainnet
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Configure mainnet asset Script hashes only if using backend asset indexing.
XUDT_CODE_HASH=
SPORE_CODE_HASH=
SPORE_CLUSTER_CODE_HASH=
FIBER_RUNTIME=wasm
