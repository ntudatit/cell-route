PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cellroute_testnet
CORS_ORIGIN=http://localhost:5173

CKB_NETWORK=testnet
CKB_RPC_URL=https://testnet.ckbapp.dev/
CKB_INDEXER_URL=https://testnet.ckbapp.dev/

# Required outside local development. Generate a long random secret.
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=3600
AUTH_CHALLENGE_TTL_SECONDS=300

# Optional protocol code-hash classification. When empty, typed cells are indexed as TYPED_CELL.
XUDT_CODE_HASH=
SPORE_CODE_HASH=
SPORE_CLUSTER_CODE_HASH=

RPC_TIMEOUT_SECONDS=12
SSE_POLL_INTERVAL_MS=2000
SSE_MAX_POLLS=300

# Observability baseline. Structured JSON logs are enabled when true.
LOG_JSON=false
OTEL_SERVICE_NAME=ckb-asset-studio-rust-service
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fiber runtime. "wasm" means Fiber lives in the browser portal through fiber-js.
FIBER_RUNTIME=wasm
# Native fallback only; not required in the normal v1.3 setup.
FIBER_RPC_URL=http://127.0.0.1:8227
FIBER_EXPECTED_VERSION=0.9.0
FIBER_BISCUIT_TOKEN=
FIBER_OPS_SCAN_INTERVAL_SECONDS=15

# FiberOps AI / RAG. With AI_PROVIDER=disabled the app still works in deterministic RAG mode.
# For an OpenAI-compatible provider, set AI_BASE_URL to the provider's /v1 base URL.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45

# Optional key protecting the read-only MCP endpoint at POST /mcp.
# Leave empty for local development only.
MCP_API_KEY=
